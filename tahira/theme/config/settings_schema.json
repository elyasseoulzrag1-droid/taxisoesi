          },
          {
            "value": "sun",
            "label": "Sunday"
          },
          {
            "value": "satsun",
            "label": "Saturday and Sunday"
          },
          {
            "value": "none",
            "label": "Every day is a dispatch day"
          }
        ],
        "default": "satsun"
      },
      {
        "type": "checkbox",
        "id": "show_eta",
        "label": "Show the dispatch countdown on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_split",
        "label": "Show the Tabby / Tamara instalment line",
        "default": true
      },
      {
        "type": "range",
        "id": "split_count",
        "label": "Number of instalments",
