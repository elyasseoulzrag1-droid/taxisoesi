  {
    "name": "Orders",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping",
        "label": "Free delivery from (store currency)",
        "default": 250,
        "info": "Shows the progress bar in the bag. Set the same threshold in Settings > Shipping. 0 hides the bar."
      },
      {
        "type": "range",
        "id": "cutoff_hour",
        "label": "Same-day dispatch cut-off (UAE time)",
