{%- comment -%} Price with compare-at. product or variant required. {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign p = target.price
  assign was = target.compare_at_price
-%}
<span class="price{% if was > p %} price--sale{% endif %}">
  <span class="price__now" data-price>{{ p | money }}</span>
  {%- if was > p -%}<s class="price__was" data-compare>{{ was | money }}</s>{%- endif -%}
</span>
