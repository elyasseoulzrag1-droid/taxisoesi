{%- comment -%}
  Prints the musk key of a product: veil, mirage, ember, halo, coffret, charm, or nothing.
  Usage: {% capture key %}{% render 'musk-key', product: product %}{% endcapture %}
  Order: metafield tahira.musk, then the products picked in Theme settings, then the handle.
{%- endcomment -%}
{%- liquid
  assign k = ''
  if product.metafields.tahira.musk != blank
    assign k = product.metafields.tahira.musk.value | default: product.metafields.tahira.musk
  elsif settings.musk_veil != blank and product.id == settings.musk_veil.id
    assign k = 'veil'
  elsif settings.musk_mirage != blank and product.id == settings.musk_mirage.id
    assign k = 'mirage'
  elsif settings.musk_ember != blank and product.id == settings.musk_ember.id
    assign k = 'ember'
  elsif settings.musk_halo != blank and product.id == settings.musk_halo.id
    assign k = 'halo'
  elsif settings.coffret != blank and product.id == settings.coffret.id
    assign k = 'coffret'
  elsif settings.charm != blank and product.id == settings.charm.id
    assign k = 'charm'
  elsif product.handle contains 'veil'
    assign k = 'veil'
  elsif product.handle contains 'mirage'
    assign k = 'mirage'
  elsif product.handle contains 'ember'
    assign k = 'ember'
  elsif product.handle contains 'halo'
    assign k = 'halo'
  elsif product.handle contains 'coffret'
    assign k = 'coffret'
  endif
  echo k | strip
-%}
