{%- comment -%} EN / عربي buttons. Needs the hidden form #LangForm (rendered once by the header). {%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  <div class="lang" role="group" aria-label="{{ 'general.language' | t }}">
    {%- for language in localization.available_languages -%}
      {%- liquid
        assign label = language.iso_code | upcase
        assign cls = ''
        if language.iso_code contains 'ar'
          assign label = 'عربي'
          assign cls = 'ar-g'
        endif
      -%}
      <button type="button" class="{{ cls }}" data-lang="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}>{{ label }}</button>
    {%- endfor -%}
  </div>
{%- endif -%}
