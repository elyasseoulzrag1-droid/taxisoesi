{%- comment -%} Fields of the customer_address form. form, id. {%- endcomment -%}
<div class="row2">
  <label>{{ 'account.first' | t }}<input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label>{{ 'account.last' | t }}<input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label>{{ 'account.company' | t }}<input type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label>{{ 'account.address1' | t }}<input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label>{{ 'account.address2' | t }}<input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="row2">
  <label>{{ 'account.city' | t }}<input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label>{{ 'account.zip' | t }}<input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
</div>
<div class="row2">
  <label>{{ 'account.country' | t }}<select name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select></label>
  <label>{{ 'account.province' | t }}<input type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></label>
</div>
<label>{{ 'account.phone' | t }}<input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="check"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}> {{ 'account.set_default' | t }}</label>
