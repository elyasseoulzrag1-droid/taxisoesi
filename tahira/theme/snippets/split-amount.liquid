{%- comment -%}
  One instalment, always with two decimals and the currency code: 42.25 AED.
  price: total in cents. Prints the amount only.
{%- endcomment -%}
{%- liquid
  assign part = price | divided_by: settings.split_count | floor
  assign whole = part | divided_by: 100 | floor
  assign frac = part | modulo: 100
  if frac < 10
    assign frac_s = '0' | append: frac
  else
    assign frac_s = frac | append: ''
  endif
  echo whole | append: '.' | append: frac_s | append: ' ' | append: cart.currency.iso_code
-%}
