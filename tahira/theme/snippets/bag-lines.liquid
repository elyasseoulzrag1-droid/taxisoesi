{%- comment -%} Cart lines, shared by the drawer and the cart page. {%- endcomment -%}
<ul class="lines">
  {%- for item in cart.items -%}
    {%- capture key -%}{% render 'musk-key', product: item.product %}{%- endcapture -%}
    {%- assign key = key | strip -%}
    {%- assign title = item.product.title -%}
    {%- if key == 'veil' or key == 'mirage' or key == 'ember' or key == 'halo' -%}
      {%- assign nk = 'musks.' | append: key | append: '.name' -%}
      {%- assign sk = 'musks.' | append: key | append: '.short' -%}
      {%- assign title = nk | t -%}
      {%- assign sub = sk | t -%}
    {%- else -%}
      {%- assign sub = '' -%}
    {%- endif -%}
    <li class="line m-{{ key }}">
      <a class="line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
        {%- elsif key == 'veil' or key == 'mirage' or key == 'ember' or key == 'halo' -%}
          {%- assign tile = 'tile-' | append: key | append: '.webp' -%}
          <img src="{{ tile | asset_url }}" alt="" width="960" height="1200" loading="lazy">
        {%- endif -%}
      </a>
      <div>
        <a class="line__name" href="{{ item.url }}">{{ title }}</a>
        {%- if sub != '' -%}<p class="line__meta">{{ sub }}</p>{%- endif -%}
        {%- unless item.product.has_only_default_variant -%}<p class="line__meta">{{ item.variant.title }}</p>{%- endunless -%}
        {%- for p in item.properties -%}
          {%- unless p.first contains '_' -%}<p class="line__meta">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}
        {%- endfor -%}
        {%- for d in item.line_level_discount_allocations -%}<p class="line__meta">{{ d.discount_application.title }}</p>{%- endfor -%}
        {%- if interactive -%}
          <div class="qty">
            <button type="button" data-line-qty="-1" data-line="{{ forloop.index }}" aria-label="{{ 'product.minus' | t }}">{% render 'icon', name: 'minus' %}</button>
            <input type="number" min="0" value="{{ item.quantity }}" data-line-input="{{ forloop.index }}" aria-label="{{ 'product.qty' | t }}">
            <button type="button" data-line-qty="1" data-line="{{ forloop.index }}" aria-label="{{ 'product.plus' | t }}">{% render 'icon', name: 'plus' %}</button>
          </div>
        {%- else -%}
          <div class="qty">
            <input type="number" min="0" name="updates[]" value="{{ item.quantity }}" data-autosubmit aria-label="{{ 'product.qty' | t }}">
          </div>
        {%- endif -%}
      </div>
      <div class="line__end">
        {%- if item.final_line_price == 0 and item.original_line_price > 0 -%}
          <span class="line__free">{{ 'general.offered' | t }}</span>
          <span class="line__price"><s>{{ item.original_line_price | money }}</s></span>
        {%- else -%}
          <span class="line__price">{{ item.final_line_price | money }}{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}</span>
        {%- endif -%}
        {%- if interactive -%}
          <button class="line__rm" type="button" data-line-remove="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
        {%- else -%}
          <a class="line__rm" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
