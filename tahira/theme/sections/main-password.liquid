<section class="hero on-dark m-veil" style="min-height:100vh;display:grid;align-items:center">
  <span class="hero__glow m-veil is-on" aria-hidden="true"></span>
  <div class="wrap" style="position:relative;display:grid;gap:28px;max-width:640px;padding-block:64px">
    {% render 'logo' %}
    <h1 class="h1" style="font-size:clamp(40px,6vw,80px)">{{ 'password.h' | t }}</h1>
    <p class="lead">{% if shop.password_message != blank %}{{ shop.password_message }}{% else %}{{ 'password.p' | t }}{% endif %}</p>
    {%- form 'customer', class: 'news__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="msg msg--ok">{{ 'newsletter.done' | t }}</p>
      {%- else -%}
        <label class="sr" for="PwEmail">{{ 'newsletter.label' | t }}</label>
        <div class="field" style="border-color:var(--on-dark);background:transparent">
          <input id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" style="color:var(--on-dark)">
          <button class="btn btn--light" type="submit">{{ 'newsletter.btn' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details>
      <summary class="link" style="cursor:pointer;list-style:none">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'form', style: 'margin-top:16px' -%}
        {%- if form.errors -%}<p class="msg msg--err">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="sr" for="Pw">{{ 'password.label' | t }}</label>
        <div class="field" style="border-color:var(--on-dark);background:transparent">
          <input id="Pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" style="color:var(--on-dark)">
          <button class="btn btn--light" type="submit">{{ 'password.btn' | t }}</button>
        </div>
      {%- endform -%}
      <p class="fine" style="margin-top:12px">{{ 'password.admin' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "class": "section-password", "settings": [] }
{% endschema %}
