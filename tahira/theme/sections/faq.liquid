{%- liquid
  assign use_built_in = false
  if section.blocks.size == 0
    assign use_built_in = true
  endif
  assign limit = section.settings.limit
  assign lab = 'faq.lab' | t
  if section.settings.label != blank
    assign lab = section.settings.label
  endif
  assign heading = 'faq.h' | t
  if section.settings.heading != blank
    assign heading = section.settings.heading
  endif
-%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="faq">
  <div class="wrap split-head">
    <div class="sec-head" data-reveal>
      <p class="lab">{{ lab }}</p>
      <h2 class="h2">{{ heading }}</h2>
      {%- if section.settings.show_link and pages['questions'] != blank and template.suffix != 'faq' -%}
        <p><a class="link" href="{{ pages['questions'].url }}">{{ 'faq.all' | t }}{% render 'icon', name: 'arrow' %}</a></p>
      {%- endif -%}
      {%- if settings.whatsapp != blank -%}
        {%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
        <p><a class="link" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}{{ 'general.whatsapp' | t }}</a></p>
      {%- endif -%}
    </div>
    <div class="faq" data-reveal>
      {%- if use_built_in -%}
        {%- for i in (1..9) limit: limit -%}
          {%- assign qk = 'faq.' | append: i | append: '.h' -%}
          {%- assign ak = 'faq.' | append: i | append: '.p' -%}
          <details{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ qk | t }}{% render 'icon', name: 'plus' %}</summary>
            <div class="faq__a"><p>{{ ak | t }}</p></div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks limit: limit -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary>
            <div class="faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.schema -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- if use_built_in -%}
        {%- for i in (1..9) limit: limit -%}
          {%- assign qk = 'faq.' | append: i | append: '.h' -%}
          {%- assign ak = 'faq.' | append: i | append: '.p' -%}
          { "@type": "Question", "name": {{ qk | t | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ ak | t | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks limit: limit -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Questions",
  "class": "section-faq",
  "settings": [
    { "type": "paragraph", "content": "With no blocks, shows the nine built-in questions (English and Arabic). Add blocks to write your own." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "limit", "label": "Questions shown", "min": 1, "max": 20, "step": 1, "default": 9 },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "checkbox", "id": "show_link", "label": "Link to the full questions page", "default": true },
    { "type": "checkbox", "id": "schema", "label": "Tell Google these are FAQs", "default": true },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Questions" }]
}
{% endschema %}
