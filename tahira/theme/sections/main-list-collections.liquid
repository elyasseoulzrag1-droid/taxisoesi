<section class="sec" style="padding-top:clamp(36px,5vw,72px)">
  <div class="wrap" style="display:grid;gap:32px">
    <h1 class="h2">{{ 'nav.shop' | t }}</h1>
    <div class="cards cards--3">
      {%- for collection in collections -%}
        {%- if collection.all_products_count > 0 -%}
          <article class="card">
            <a class="card__media" href="{{ collection.url }}" tabindex="-1" aria-hidden="true">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                <img src="{{ 'lineup.webp' | asset_url }}" width="2000" height="1100" alt="" loading="lazy">
              {%- endif -%}
            </a>
            <div class="card__body">
              <h2 class="card__name" style="font-size:28px;letter-spacing:.04em"><a href="{{ collection.url }}">{{ collection.title }}</a></h2>
              <p class="card__note">{{ 'collection.count' | t: n: collection.all_products_count }}</p>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collections", "class": "section-list-collections", "settings": [] }
{% endschema %}
