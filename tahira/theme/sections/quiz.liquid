{%- liquid
  assign keys = 'veil,mirage,ember,halo' | split: ','
  assign partners = 'ember,halo,veil,mirage' | split: ','
-%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="quiz" data-quiz>
  <div class="wrap quiz">
    <div class="sec-head" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'quiz.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'quiz.h' | t }}{% endif %}</h2>
      <p class="lead">{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'quiz.p' | t }}{% endif %}</p>
    </div>

    <div data-reveal>
      <div class="quiz__box">
        <div class="quiz__top">
          <span class="lab lab--plain" data-q-step data-tpl="{{ 'quiz.step' | t: n: '__N__' | escape }}">{{ 'quiz.step' | t: n: 1 }}</span>
          <button class="quiz__again" type="button" data-q-again hidden>{{ 'quiz.again' | t }}</button>
        </div>
        <div class="quiz__bar" aria-hidden="true"><i style="width:33%"></i></div>

        <div data-q>
          <h3 class="quiz__q">{{ 'quiz.q1' | t }}</h3>
          <div class="quiz__opts">
            {%- assign opts = 'q1a,q1b,q1c' | split: ',' -%}
            {%- for o in opts -%}
              {%- assign ok = 'quiz.' | append: o -%}
              <button type="button" data-q-opt="{{ forloop.index0 }}">{{ ok | t }}{% render 'icon', name: 'arrow' %}</button>
            {%- endfor -%}
          </div>
        </div>
        <div data-q hidden>
          <h3 class="quiz__q">{{ 'quiz.q2' | t }}</h3>
          <div class="quiz__opts">
            {%- assign opts = 'q2a,q2b,q2c,q2d' | split: ',' -%}
            {%- for o in opts -%}
              {%- assign ok = 'quiz.' | append: o -%}
              <button type="button" data-q-opt="{{ forloop.index0 }}">{{ ok | t }}{% render 'icon', name: 'arrow' %}</button>
            {%- endfor -%}
          </div>
        </div>
        <div data-q hidden>
          <h3 class="quiz__q">{{ 'quiz.q3' | t }}</h3>
          <div class="quiz__opts">
            {%- assign opts = 'q3a,q3b,q3c,q3d' | split: ',' -%}
            {%- for o in opts -%}
              {%- assign ok = 'quiz.' | append: o -%}
              <button type="button" data-q-opt="{{ forloop.index0 }}">{{ ok | t }}{% render 'icon', name: 'arrow' %}</button>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- for key in keys -%}
        {%- liquid
          assign sid = 'musk_' | append: key
          assign p = settings[sid]
          assign partner = partners[forloop.index0]
          assign pid = 'musk_' | append: partner
          assign pp = settings[pid]
          assign nk = 'musks.' | append: key | append: '.name'
          assign sk = 'musks.' | append: key | append: '.short'
          assign wk = 'musks.' | append: key | append: '.who'
          assign pk = 'musks.' | append: partner | append: '.name'
          assign psk = 'musks.' | append: partner | append: '.short'
        -%}
        <div class="qres on-dark m-{{ key }}" data-q-result="{{ key }}" hidden aria-live="polite">
          {% render 'tube', key: key %}
          <div class="qres__txt">
            <p class="lab">{{ 'quiz.result' | t }}</p>
            <p class="qres__name h2">{{ nk | t }}</p>
            <p class="lead">{{ sk | t }}</p>
            <p class="body">{{ wk | t }}</p>
            <div class="qres__acts">
              {%- if p != blank and p.available -%}
                <form action="{{ routes.cart_add_url }}" method="post" data-add>
                  <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button class="btn btn--light" type="submit"><span>{{ 'product.add' | t }}</span></button>
                </form>
              {%- endif -%}
              <a class="btn btn--ghost-light" href="{{ p.url | default: routes.all_products_collection_url }}">{{ 'quiz.see' | t }}</a>
            </div>
            <p class="qres__with">
              {{ 'quiz.with' | t }}: <a href="{{ pp.url | default: '#pairs' }}">{{ pk | t }}, {{ psk | t | downcase }}</a>
              · <button class="quiz__again" type="button" data-q-again style="color:inherit">{{ 'quiz.again' | t }}</button>
            </p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz: which one is yours",
  "class": "section-quiz",
  "settings": [
    { "type": "paragraph", "content": "Three questions, one musk. Questions and answers are built in, in English and Arabic." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "tint"
    }
  ],
  "presets": [{ "name": "Quiz" }]
}
{% endschema %}
