<section class="sec">
  <div class="wrap">
    <div class="box">
      <h1 class="h2">{{ 'account.activate_h' | t }}</h1>
      <p class="body">{{ 'account.activate_p' | t }}</p>
      {%- form 'activate_customer_password', class: 'form' -%}
        {%- if form.errors -%}<div class="msg msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>{{ 'account.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label>{{ 'account.confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <div class="acts">
          <button class="btn" type="submit">{{ 'account.activate' | t }}</button>
          <button class="btn btn--line" type="submit" name="decline">{{ 'account.decline' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Activate account", "class": "section-activate", "settings": [] }
{% endschema %}
