{%- assign rows = 'base,fmt,last,tex,hold,comp,mat,life,del' | split: ',' -%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}">
  <div class="wrap split-head">
    <div class="sec-head" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'spec.lab' | t }}{% endif %}</p>
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      <p class="body">{{ 'house.fine' | t }}</p>
    </div>
    <dl class="spec" data-reveal>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>
        {%- endfor -%}
      {%- else -%}
        {%- for r in rows -%}
          {%- assign lk = 'spec.' | append: r -%}
          {%- assign vk = 'spec.' | append: r | append: '_v' -%}
          <div><dt>{{ lk | t }}</dt><dd>{{ vk | t }}</dd></div>
        {%- endfor -%}
      {%- endif -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Specification",
  "class": "section-spec",
  "settings": [
    { "type": "paragraph", "content": "With no blocks, shows the built-in specification (base, format, hold, made in France...)." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "value", "label": "Value" }
      ]
    }
  ],
  "presets": [{ "name": "Specification" }]
}
{% endschema %}
