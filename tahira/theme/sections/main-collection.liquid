{%- paginate collection.products by section.settings.per_page -%}
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <header class="c-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      </nav>
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lead rte">{{ collection.description }}</div>
      {%- elsif settings.musks_collection != blank and collection.id == settings.musks_collection.id -%}
        <p class="lead">{{ 'collection.shop_long' | t }}</p>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      <div class="cards">
        {%- for product in collection.products -%}
          {% render 'musk-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lead">{{ 'collection.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pag" aria-label="{{ 'general.page' | t: n: paginate.current_page }}">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'back' %}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="current" aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "class": "section-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
