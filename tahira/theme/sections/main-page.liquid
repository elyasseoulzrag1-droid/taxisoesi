<section class="sec" style="padding-top:clamp(36px,5vw,72px)">
  <div class="wrap wrap--text" style="display:grid;gap:24px">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>
    <h1 class="h2">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "class": "section-page",
  "settings": []
}
{% endschema %}
