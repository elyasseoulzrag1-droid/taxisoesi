{%- liquid
  assign keys = 'veil,mirage,ember,halo' | split: ','
  assign start = section.settings.start
-%}
<section class="hero on-dark m-{{ start }}" data-hero aria-label="{{ 'hero.choose' | t }}">
  {%- for key in keys -%}
    <span class="hero__glow m-{{ key }}{% if key == start %} is-on{% endif %}" data-key="{{ key }}" aria-hidden="true"></span>
  {%- endfor -%}
  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="lab">{% if section.settings.eyebrow != blank %}{{ section.settings.eyebrow }}{% else %}{{ 'hero.eyebrow' | t }}{% endif %}</p>
      {%- if section.settings.heading != blank -%}
        <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h1 class="h1">{{ 'hero.title_html' | t }}</h1>
      {%- endif -%}
      <p class="hero__sub">{% if section.settings.sub != blank %}{{ section.settings.sub }}{% else %}{{ 'hero.sub' | t }}{% endif %}</p>

      <div class="hero__pick" role="group" aria-label="{{ 'hero.choose' | t }}">
        {%- for key in keys -%}
          {%- assign nk = 'musks.' | append: key | append: '.name' -%}
          {%- assign sk = 'musks.' | append: key | append: '.short' -%}
          <button class="hero__opt m-{{ key }}" type="button" data-key="{{ key }}" aria-pressed="{% if key == start %}true{% else %}false{% endif %}">
            <i aria-hidden="true"></i><b>{{ nk | t }}</b><span>{{ sk | t }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- assign lk = 'musks.' | append: start | append: '.line' -%}
      <p class="hero__line" data-hero-line>{{ lk | t }}</p>

      {%- assign sid = 'musk_' | append: start -%}
      {%- assign p0 = settings[sid] -%}
      <div class="hero__buy">
        <span class="hero__price" data-hero-price>{% if p0 != blank %}{{ p0.price | money }}{% endif %}</span>
        <form action="{{ routes.cart_add_url }}" method="post" data-add data-hero-form>
          <input type="hidden" name="id" value="{{ p0.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="btn btn--light" type="submit"{% if p0 == blank %} hidden{% endif %}><span>{{ 'hero.add' | t }}</span></button>
        </form>
        <a class="btn btn--ghost-light" href="{{ p0.url | default: routes.all_products_collection_url }}" data-hero-link>{{ 'hero.see' | t }}</a>
        {%- if settings.show_split -%}
          <p class="split" data-hero-split>
            {%- if p0 != blank -%}
              {%- assign part = p0.price | divided_by: settings.split_count | floor | money -%}
              {{ 'product.split' | t: n: part, c: settings.split_count }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__stage" aria-hidden="true">
      {%- for key in keys -%}
        <div class="hero__tube{% if key == start %} is-on{% endif %}" data-key="{{ key }}">
          {%- if key == start -%}
            {% render 'tube', key: key, eager: true %}
          {%- else -%}
            {% render 'tube', key: key %}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-hero-data>
    [
      {%- for key in keys -%}
        {%- liquid
          assign sid = 'musk_' | append: key
          assign p = settings[sid]
          assign lk = 'musks.' | append: key | append: '.line'
          assign split = ''
          assign price = ''
          if p != blank
            assign price = p.price | money
            if settings.show_split
              assign part = p.price | divided_by: settings.split_count | floor | money
              assign split = 'product.split' | t: n: part, c: settings.split_count
            endif
          endif
        -%}
        {
          "key": {{ key | json }},
          "line": {{ lk | t | json }},
          "price": {{ price | json }},
          "split": {{ split | json }},
          "variant": {% if p != blank %}{{ p.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
          "available": {% if p != blank and p.available %}true{% else %}false{% endif %},
          "url": {{ p.url | default: routes.all_products_collection_url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Hero: the four musks",
  "class": "section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "The products come from Theme settings > The four musks. Leave the texts empty to use the built-in English and Arabic copy."
    },
    {
      "type": "select",
      "id": "start",
      "label": "Musk shown first",
      "options": [
        { "value": "veil", "label": "VEIL" },
        { "value": "mirage", "label": "MIRAGE" },
        { "value": "ember", "label": "EMBER" },
        { "value": "halo", "label": "HALO" }
      ],
      "default": "veil"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "sub", "label": "Text" }
  ],
  "presets": [{ "name": "Hero: the four musks" }]
}
{% endschema %}
