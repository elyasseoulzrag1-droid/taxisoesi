{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'videos.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'videos.h' | t }}{% endif %}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="reel">
        {%- for block in section.blocks -%}
          <figure class="reel__item" {{ block.shopify_attributes }} style="margin:0">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '600x' }}
              <button class="reel__toggle" type="button" aria-pressed="false" aria-label="{{ 'videos.pause' | t }}">{% render 'icon', name: 'pause' %}</button>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption class="reel__cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="editor-hint">Add vertical videos (9:16) uploaded to Shopify: try-ons, unboxings, customer clips.</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Video reel",
  "class": "section-reel",
  "settings": [
    { "type": "paragraph", "content": "Vertical videos play muted when they scroll into view. Hidden on the store until you add one." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Or an image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "Video reel" }]
}
{% endschema %}
