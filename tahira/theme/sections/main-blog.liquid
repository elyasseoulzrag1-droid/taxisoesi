{%- paginate blog.articles by 12 -%}
<section class="sec" style="padding-top:clamp(36px,5vw,72px)">
  <div class="wrap" style="display:grid;gap:32px">
    <h1 class="h2">{{ blog.title }}</h1>
    <div class="cards cards--3">
      {%- for article in blog.articles -%}
        <article class="card">
          {%- if article.image -%}
            <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</a>
          {%- endif -%}
          <div class="card__body">
            <p class="card__tag">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="card__name" style="font-size:26px;letter-spacing:0"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__note">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pag">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Journal", "class": "section-blog", "settings": [] }
{% endschema %}
