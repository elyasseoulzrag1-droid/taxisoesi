<section class="sec">
  <div class="wrap">
    <div class="box">
      <h1 class="h2">{{ 'account.reset_h' | t }}</h1>
      {%- form 'reset_customer_password', class: 'form' -%}
        {%- if form.errors -%}<div class="msg msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label>{{ 'account.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label>{{ 'account.confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <button class="btn btn--full" type="submit">{{ 'account.save' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Reset password", "class": "section-reset", "settings": [] }
{% endschema %}
