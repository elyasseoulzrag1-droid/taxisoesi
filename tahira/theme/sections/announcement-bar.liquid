{%- if section.blocks.size > 0 -%}
<div class="ann">
  <div class="wrap ann__in">
    {%- for block in section.blocks -%}
      {%- liquid
        if block.settings.message == 'custom'
          assign msg = block.settings.text
        else
          assign k = 'announcement.' | append: block.settings.message
          assign msg = k | t
        endif
      -%}
      {%- if block.settings.link != blank -%}
        <a class="ann__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ msg }}</a>
      {%- else -%}
        <p class="ann__item" {{ block.shopify_attributes }}>{{ msg }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-ann",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "message",
          "label": "Message",
          "info": "Built-in messages are already translated into Arabic.",
          "options": [
            { "value": "ship", "label": "Free delivery over 250 AED" },
            { "value": "pay", "label": "Cash on delivery, Tabby, Tamara" },
            { "value": "spec", "label": "Made in France, lasts 2 to 3 months" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "ship"
        },
        { "type": "text", "id": "text", "label": "Custom text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
