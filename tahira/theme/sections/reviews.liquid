{%- liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="reviews">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'reviews.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'reviews.h' | t }}{% endif %}</h2>
    </div>

    {%- if reviews.size > 0 -%}
      <div class="reviews" data-carousel>
        {%- for block in reviews -%}
          {%- assign key = block.settings.musk -%}
          <figure class="review m-{{ key }}" {{ block.shopify_attributes }} data-reveal>
            <span class="stars" aria-label="{{ 'hero.rating' | t: n: block.settings.stars }}">
              {%- for i in (1..block.settings.stars) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
            </span>
            <blockquote>{{ block.settings.quote }}</blockquote>
            {%- if key != 'none' -%}
              {%- assign nk = 'musks.' | append: key | append: '.name' -%}
              <span class="review__musk"><i></i>{{ nk | t }}</span>
            {%- endif -%}
            <figcaption class="review__who">
              {%- if block.settings.photo != blank -%}
                {{ block.settings.photo | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
              {%- endif -%}
              <span>
                <b>{{ block.settings.name }}</b>
                <span>{{ block.settings.city }}{% if block.settings.verified %} · {{ 'reviews.verified' | t }}{% endif %}</span>
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if reviews.size == 0 and has_app == false -%}
      <p class="editor-hint">{{ 'reviews.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "class": "section-reviews",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only real customer words. The section stays hidden on the store until you add a review or a reviews app block (Judge.me, Loox, Shopify Product Reviews)."
    },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "tint"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "What she said" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        {
          "type": "select",
          "id": "musk",
          "label": "Musk",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "veil", "label": "VEIL" },
            { "value": "mirage", "label": "MIRAGE" },
            { "value": "ember", "label": "EMBER" },
            { "value": "halo", "label": "HALO" }
          ],
          "default": "none"
        },
        { "type": "checkbox", "id": "verified", "label": "Verified order", "default": true },
        { "type": "image_picker", "id": "photo", "label": "Photo" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
