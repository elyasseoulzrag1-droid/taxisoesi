<section class="sec" style="padding-top:clamp(32px,4vw,56px)">
  <div class="wrap wrap--narrow">
    <div class="sec-head">
      <h1 class="h2">{{ 'cart.title' | t }}</h1>
    </div>
    {%- if cart.item_count == 0 -%}
      <div style="display:grid;gap:20px;justify-items:start">
        <p class="lead">{{ 'cart.empty' | t }}</p>
        <a class="btn" href="{{ settings.musks_collection.url | default: routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm" style="display:grid;gap:0">
        {% render 'bag-extras', position: 'top' %}
        {% render 'bag-lines', interactive: false %}
        {%- if section.settings.show_note -%}
          <label class="form" style="margin-top:24px">
            <span>{{ 'cart.note' | t }}</span>
            <textarea name="note" rows="3">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}
        <div class="bag__foot" style="padding-inline:0;border:0;margin-top:20px">
          {%- for d in cart.cart_level_discount_applications -%}
            <div class="bag__row fine"><span>{{ d.title }}</span><span>-{{ d.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="bag__row"><span>{{ 'cart.sub' | t }}</span><b>{{ cart.total_price | money }}</b></div>
          {% render 'split-pay', price: cart.total_price %}
          <button class="btn btn--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          <noscript><button class="btn btn--line btn--full" type="submit" name="update">{{ 'account.save' | t }}</button></noscript>
          <p class="fine" style="text-align:center">{{ 'cart.taxes' | t }}</p>
        </div>
      </form>
      {% render 'bag-extras', position: 'upsell' %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bag",
  "class": "section-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Let customers leave a note", "default": false }
  ]
}
{% endschema %}
