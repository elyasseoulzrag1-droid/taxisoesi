{%- assign keys = 'veil,mirage,ember,halo' | split: ',' -%}
<section class="sec sec--line">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'chart.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'chart.h' | t }}{% endif %}</h2>
      <p class="lead">{{ 'chart.p' | t }}</p>
    </div>
    <div class="chart-wrap" data-reveal>
      <table class="chart">
        <thead>
          <tr>
            <th scope="col"><span class="sr">{{ 'nav.shop' | t }}</span></th>
            <th scope="col">{{ 'musks.labels.family' | t }}</th>
            <th scope="col">{{ 'musks.labels.when' | t }}</th>
            <th scope="col">{{ 'musks.labels.presence' | t }}</th>
            <th scope="col">{{ 'musks.labels.hold' | t }}</th>
            <th scope="col">{{ 'musks.labels.price' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for key in keys -%}
            {%- liquid
              assign sid = 'musk_' | append: key
              assign p = settings[sid]
              assign nk = 'musks.' | append: key | append: '.name'
              assign sk = 'musks.' | append: key | append: '.short'
              assign tk = 'musks.' | append: key | append: '.tag'
              case key
                when 'veil'
                  assign presence = 2
                  assign hold = 4
                when 'mirage'
                  assign presence = 4
                  assign hold = 5
                when 'ember'
                  assign presence = 5
                  assign hold = 4
                else
                  assign presence = 3
                  assign hold = 5
              endcase
            -%}
            <tr class="m-{{ key }}">
              <th scope="row"><a href="{{ p.url | default: '#' }}"><i aria-hidden="true"></i>{{ nk | t }}</a></th>
              <td>{{ sk | t }}</td>
              <td>{{ tk | t }}</td>
              <td><span class="meter__bar" role="img" aria-label="{{ 'musks.labels.scale' | t: n: presence }}">{% for i in (1..5) %}<i{% if i <= presence %} class="on"{% endif %}></i>{% endfor %}</span></td>
              <td><span class="meter__bar" role="img" aria-label="{{ 'musks.labels.scale' | t: n: hold }}">{% for i in (1..5) %}<i{% if i <= hold %} class="on"{% endif %}></i>{% endfor %}</span></td>
              <td>{% if p != blank %}{{ p.price | money }}{% endif %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The four, side by side",
  "class": "section-chart",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "presets": [{ "name": "The four, side by side" }]
}
{% endschema %}
