<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="letter">
  <div class="wrap news">
    <div style="display:grid;gap:18px" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'newsletter.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'newsletter.h' | t }}{% endif %}</h2>
      <p class="lead">{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'newsletter.p' | t }}{% endif %}</p>
    </div>
    <div style="display:grid;gap:12px" data-reveal>
      {%- form 'customer', id: 'NewsletterForm', class: 'news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="msg msg--ok" role="status">{{ 'newsletter.done' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}<p class="msg msg--err" role="alert">{{ 'newsletter.error' | t }}</p>{%- endif -%}
          <label class="sr" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
          <div class="field">
            <input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" inputmode="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
            <button class="btn" type="submit">{{ 'newsletter.btn' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
      <p class="fine">{{ 'newsletter.fine' | t }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-news",
  "settings": [
    { "type": "paragraph", "content": "Emails land in Customers, tagged 'newsletter', with marketing consent." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "tint"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
