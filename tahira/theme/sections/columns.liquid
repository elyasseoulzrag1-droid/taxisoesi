{%- comment -%}
  Columns of short texts. Either a built-in set (translated into Arabic) or your own blocks.
{%- endcomment -%}
{%- liquid
  assign set = section.settings.content
  assign count = 0
  assign has_p = false
  assign has_k = false
  assign has_lab = true
  assign has_h = true
  case set
    when 'read'
      assign count = 3
      assign has_p = true
      assign has_k = true
    when 'france'
      assign count = 3
      assign has_p = true
      assign has_k = true
    when 'make'
      assign count = 4
    when 'charter'
      assign count = 4
      assign has_p = true
    when 'why'
      assign count = 3
    when 'start'
      assign count = 3
      assign has_p = true
    when 'steps'
      assign count = 4
      assign has_h = false
    when 'applicator'
      assign count = 3
    when 'where'
      assign count = 6
      assign has_p = true
    when 'when'
      assign count = 4
    when 'hold'
      assign count = 2
      assign has_p = true
      assign has_k = true
    when 'ways'
      assign count = 3
    when 'words'
      assign count = 12
      assign has_p = true
    when 'care'
      assign count = 3
      assign has_k = true
  endcase

  assign lab = section.settings.label
  assign heading = section.settings.heading
  assign intro = section.settings.text
  if count > 0
    assign lk = set | append: '.lab'
    assign hk = set | append: '.h'
    assign pk = set | append: '.p'
    if lab == blank and has_lab
      assign lab = lk | t
    endif
    if heading == blank and has_h
      assign heading = hk | t
    endif
    if intro == blank and has_p
      assign intro = pk | t
    endif
  endif

  assign n = section.settings.columns
  assign layout = section.settings.layout
  assign bg = section.settings.bg
-%}
<section class="sec{% if bg != 'paper' %} sec--{{ bg }}{% endif %}{% if bg == 'ink' %} on-dark{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="wrap{% if layout == 'side' %} split-head{% endif %}">
    {%- if section.settings.show_head and lab != blank or section.settings.show_head and heading != blank -%}
      <div class="sec-head" data-reveal>
        {%- if lab != blank -%}<p class="lab">{{ lab }}</p>{%- endif -%}
        {%- if heading != blank -%}<h2 class="h2">{{ heading }}</h2>{%- endif -%}
        {%- if intro != blank -%}<p class="lead">{{ intro }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cols{% if layout == 'list' %} cols--list{% endif %}" style="--n:{{ n }}">
      {%- if count > 0 -%}
        {%- for i in (1..count) -%}
          {%- liquid
            assign base = set | append: '.' | append: i
            assign ck = base | append: '.k'
            assign ch = base | append: '.h'
            assign cp = base | append: '.p'
            assign hl = false
            if section.settings.highlight_last and forloop.last
              assign hl = true
            endif
          -%}
          <div class="col{% if hl %} col--hl{% endif %}" data-reveal>
            {%- if has_k -%}
              <span class="col__k">{{ ck | t }}</span>
            {%- elsif section.settings.numbers -%}
              <span class="col__k">{% if i < 10 %}0{% endif %}{{ i }}</span>
            {%- endif -%}
            <h3>{{ ch | t }}</h3>
            <p>{{ cp | t }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign hl = false
            if section.settings.highlight_last and forloop.last
              assign hl = true
            endif
          -%}
          <div class="col{% if hl %} col--hl{% endif %}" {{ block.shopify_attributes }} data-reveal>
            {%- if block.settings.k != blank -%}
              <span class="col__k">{{ block.settings.k }}</span>
            {%- elsif section.settings.numbers -%}
              <span class="col__k">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if set == 'where' -%}<p class="fine" style="margin-top:20px">{{ 'where.fine' | t }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Columns",
  "class": "section-cols",
  "settings": [
    {
      "type": "select",
      "id": "content",
      "label": "Built-in content",
      "info": "Built-in sets are written in English and Arabic. Choose 'My own blocks' to write yours.",
      "options": [
        { "value": "custom", "label": "My own blocks" },
        { "value": "read", "label": "A new reading of musk" },
        { "value": "france", "label": "Made in France" },
        { "value": "make", "label": "How it is made" },
        { "value": "charter", "label": "What we will never do" },
        { "value": "why", "label": "Why it is worn daily" },
        { "value": "start", "label": "Never worn musk? Start here" },
        { "value": "steps", "label": "The ritual: four movements" },
        { "value": "applicator", "label": "The applicator" },
        { "value": "where", "label": "Where it goes: six warm points" },
        { "value": "when", "label": "Four moments in a day" },
        { "value": "hold", "label": "Oil against spray" },
        { "value": "ways", "label": "Three ways to wear it" },
        { "value": "words", "label": "The words, explained" },
        { "value": "care", "label": "Delivery, payment, returns" }
      ],
      "default": "custom"
    },
    { "type": "checkbox", "id": "show_head", "label": "Show the heading", "default": true },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Intro" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Heading on top, columns below" },
        { "value": "side", "label": "Heading on the side" },
        { "value": "list", "label": "Numbered list" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "numbers", "label": "Number the items", "default": true },
    { "type": "checkbox", "id": "highlight_last", "label": "Highlight the last item", "default": false },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Lets a link jump here, for example 'where' for #where." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "k", "label": "Small label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Columns", "settings": { "content": "why" } }]
}
{% endschema %}
