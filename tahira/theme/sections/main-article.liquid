<article class="sec" style="padding-top:clamp(36px,5vw,72px)">
  <div class="wrap wrap--text" style="display:grid;gap:24px">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ blog.url }}">{% render 'icon', name: 'back' %}</a>
      <a href="{{ blog.url }}">{{ 'blog.back' | t }}</a>
    </nav>
    <p class="lab">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h2">{{ article.title }}</h1>
    {%- if article.author != blank -%}<p class="fine">{{ 'blog.by' | t: n: article.author }}</p>{%- endif -%}
    {%- if article.image -%}
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw' }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "class": "section-article", "settings": [] }
{% endschema %}
