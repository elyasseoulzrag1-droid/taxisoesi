{%- comment -%} Through the day: where the musk is, hour by hour (08:00 to 23:00). {%- endcomment -%}
{%- liquid
  capture key
    render 'musk-key', product: product
  endcapture
  assign key = key | strip
  assign keys = 'veil,mirage,ember,halo' | split: ','
-%}
{%- if keys contains key and key != '' -%}
<section class="sec day m-{{ key }}">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <p class="lab">{{ 'clock.lab' | t }}</p>
      <h2 class="h2">{{ 'clock.h' | t }}</h2>
    </div>
    <ol class="day__line">
      {%- for i in (1..5) -%}
        {%- assign kk = 'clock.' | append: i | append: '.k' -%}
        {%- assign kp = 'clock.' | append: i | append: '.p' -%}
        <li class="day__step" style="--i:{{ i }}" data-reveal>
          <span class="day__dot" aria-hidden="true"></span>
          <b class="day__time">{{ kk | t }}</b>
          <p>{{ kp | t }}</p>
        </li>
      {%- endfor -%}
    </ol>
    <p class="fine" style="margin-top:22px">{{ 'clock.note' | t }}</p>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Through the day",
  "class": "section-day",
  "settings": [
    { "type": "paragraph", "content": "Shown on the four musk pages: where the scent is at 08:00, 12:00, 16:00, 20:00 and 23:00." }
  ]
}
{% endschema %}
