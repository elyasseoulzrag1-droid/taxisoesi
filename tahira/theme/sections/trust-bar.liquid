{%- liquid
  assign icons = 'flag,clock,drop,card' | split: ','
-%}
<section class="trust" aria-label="{{ 'footer.orders' | t }}">
  <div class="wrap trust__in">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <b>{{ block.settings.title }}</b>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for icon in icons -%}
        {%- assign hk = 'trust.' | append: forloop.index | append: '.h' -%}
        {%- assign pk = 'trust.' | append: forloop.index | append: '.p' -%}
        <div class="trust__item">
          {% render 'icon', name: icon %}
          <b>{{ hk | t }}</b>
          <p>{{ pk | t }}</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reassurance bar",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "With no blocks, shows the built-in four: Made in France, 6 to 8 hours, alcohol-free, pay at the door (translated into Arabic). Add blocks to write your own."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flag", "label": "Flag" },
            { "value": "clock", "label": "Clock" },
            { "value": "drop", "label": "Drop" },
            { "value": "card", "label": "Card" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Delivered in 1 to 3 days" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tracked, anywhere in the Emirates." }
      ]
    }
  ],
  "presets": [{ "name": "Reassurance bar" }]
}
{% endschema %}
