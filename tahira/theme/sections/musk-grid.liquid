{%- liquid
  assign keys = 'veil,mirage,ember,halo' | split: ','
  assign shop_url = settings.musks_collection.url | default: routes.all_products_collection_url
-%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="four">
  <div class="wrap">
    <div class="sec-head sec-head--row" data-reveal>
      <div style="display:grid;gap:16px;max-width:760px">
        <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'grid.lab' | t }}{% endif %}</p>
        <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'grid.h' | t }}{% endif %}</h2>
        <p class="lead">{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'grid.p' | t }}{% endif %}</p>
      </div>
      <a class="btn btn--line" href="{{ shop_url }}">{{ 'grid.all' | t }}</a>
    </div>
    <div class="cards cards--scroll" data-carousel>
      {%- for key in keys -%}
        {%- assign sid = 'musk_' | append: key -%}
        {% render 'musk-card', product: settings[sid], key: key, index: forloop.index %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The four musks",
  "class": "section-grid",
  "settings": [
    { "type": "paragraph", "content": "Products come from Theme settings > The four musks. Leave the texts empty for the built-in copy." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "paper"
    }
  ],
  "presets": [{ "name": "The four musks" }]
}
{% endschema %}
