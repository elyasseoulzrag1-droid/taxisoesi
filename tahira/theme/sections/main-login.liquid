<section class="sec">
  <div class="wrap">
    <div class="box">
      <div id="Login" style="display:grid;gap:20px">
        <h1 class="h2">{{ 'account.login' | t }}</h1>
        {%- form 'customer_login', class: 'form' -%}
          {%- if form.errors -%}<div class="msg msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label>{{ 'account.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
          {%- if form.password_needed -%}
            <label>{{ 'account.password' | t }}<input type="password" name="customer[password]" autocomplete="current-password" required></label>
            <a class="fine" href="#recover">{{ 'account.forgot' | t }}</a>
          {%- endif -%}
          <button class="btn btn--full" type="submit">{{ 'account.login' | t }}</button>
        {%- endform -%}
        <p class="fine">{{ 'account.new_customer' | t }} <a href="{{ routes.account_register_url }}">{{ 'account.register' | t }}</a></p>
        {%- if shop.checkout.guest_login -%}
          {%- form 'guest_login' -%}<button class="btn btn--line btn--full" type="submit">{{ 'account.guest' | t }}</button>{%- endform -%}
        {%- endif -%}
      </div>
      <div id="recover" style="display:grid;gap:16px;padding-top:24px;border-top:1px solid var(--line)">
        <h2 class="h3">{{ 'account.reset_h' | t }}</h2>
        <p class="body">{{ 'account.reset_p' | t }}</p>
        {%- form 'recover_customer_password', class: 'form' -%}
          {%- if form.posted_successfully? -%}<p class="msg msg--ok">{{ 'account.reset_sent' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<div class="msg msg--err">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label>{{ 'account.email' | t }}<input type="email" name="email" autocomplete="email" required></label>
          <button class="btn btn--line" type="submit">{{ 'account.submit' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Log in", "class": "section-login", "settings": [] }
{% endschema %}
