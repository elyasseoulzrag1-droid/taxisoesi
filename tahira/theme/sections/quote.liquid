<section class="sec quote{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}">
  {%- if settings.logo_arabic != blank -%}<span class="quote__wm" aria-hidden="true">{{ settings.logo_arabic }}</span>{%- endif -%}
  <div class="wrap" data-reveal>
    <p>{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'quote.p' | t }}{% endif %}</p>
    <span>{% if section.settings.author != blank %}{{ section.settings.author }}{% else %}{{ 'quote.s' | t }}{% endif %}</span>
  </div>
</section>

{% schema %}
{
  "name": "Quote",
  "class": "section-quote",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Quote", "info": "Leave empty for 'Four musks, and nothing else.'" },
    { "type": "text", "id": "author", "label": "Signature" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "paper"
    }
  ],
  "presets": [{ "name": "Quote" }]
}
{% endschema %}
