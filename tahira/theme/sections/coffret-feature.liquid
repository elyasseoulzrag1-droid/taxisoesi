{%- liquid
  assign p = section.settings.product | default: settings.coffret
  assign keys = 'veil,mirage,ember,halo' | split: ','
  assign singles = 0
  for key in keys
    assign sid = 'musk_' | append: key
    if settings[sid] != blank
      assign singles = singles | plus: settings[sid].price
    endif
  endfor
  assign price = p.price | default: 0
  assign was = p.compare_at_price | default: 0
  if was <= price
    assign was = singles
  endif
  assign save = 0
  if was > price and price > 0
    assign save = was | minus: price | times: 100 | divided_by: was | floor
  endif
-%}
<section class="sec{% if section.settings.bg != 'paper' %} sec--{{ section.settings.bg }}{% endif %}" id="coffret">
  <div class="wrap mt{% if section.settings.flip %} mt--rev{% endif %}">
    <div class="mt__media" data-reveal>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: section.settings.image.alt }}
      {%- elsif p.featured_media != blank -%}
        {{ p.featured_media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw' }}
      {%- else -%}
        <img src="{{ 'coffret.webp' | asset_url }}" width="1480" height="1001" alt="" loading="lazy" decoding="async">
      {%- endif -%}
    </div>
    <div class="mt__txt" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'coffret.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'coffret.h' | t }}{% endif %}</h2>
      <p class="lead">{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'coffret.long' | t }}{% endif %}</p>
      <ul class="ticks">
        {%- assign items = 'i1,i2,i3' | split: ',' -%}
        {%- for i in items -%}
          {%- assign ik = 'coffret.' | append: i -%}
          <li>{% render 'icon', name: 'check' %}<span>{{ ik | t }}</span></li>
        {%- endfor -%}
      </ul>
      {%- if p != blank -%}
        <div class="mt__price">
          <span>{{ price | money }}</span>
          {%- if was > price -%}
            {%- assign was_money = was | money -%}
            <s>{{ 'coffret.was' | t: n: was_money }}</s>
          {%- endif -%}
          {%- if save > 0 -%}<span class="save">{{ 'coffret.save' | t: n: save }}</span>{%- endif -%}
        </div>
        {% render 'split-pay', price: price %}
      {%- endif -%}
      <div class="acts">
        {%- if p != blank and p.available -%}
          <form action="{{ routes.cart_add_url }}" method="post" data-add>
            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="btn" type="submit"><span>{{ 'coffret.add' | t }}</span></button>
          </form>
        {%- endif -%}
        <a class="btn btn--line" href="{{ p.url | default: routes.all_products_collection_url }}">{{ 'coffret.cta' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coffret",
  "class": "section-coffret",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use the coffret from Theme settings." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "flip", "label": "Image on the other side", "default": false },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "White" },
        { "value": "tint", "label": "Tint" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "sand"
    }
  ],
  "presets": [{ "name": "Coffret" }]
}
{% endschema %}
