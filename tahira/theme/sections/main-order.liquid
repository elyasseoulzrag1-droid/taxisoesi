<section class="sec">
  <div class="wrap" style="display:grid;gap:28px">
    <a class="link" href="{{ routes.account_url }}">{% render 'icon', name: 'back' %}{{ 'account.back' | t }}</a>
    <h1 class="h2">{{ 'account.order' | t }} {{ order.name }}</h1>
    <p class="fine">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date' -%}
      <p class="msg msg--err">{{ 'account.cancelled' | t: n: cancelled_at }}</p>
    {%- endif -%}
    <div style="overflow-x:auto">
      <table class="tbl">
        <thead><tr><th>{{ 'account.product' | t }}</th><th>{{ 'account.price' | t }}</th><th>{{ 'account.qty' | t }}</th><th>{{ 'account.total' | t }}</th></tr></thead>
        <tbody>
          {%- for item in order.line_items -%}
            <tr>
              <td><a href="{{ item.product.url }}">{{ item.title }}</a></td>
              <td>{{ item.final_price | money }}</td>
              <td>{{ item.quantity }}</td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">{{ 'account.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}
            <tr><td colspan="3">{{ discount.title }}</td><td>-{{ discount.total_allocated_amount | money }}</td></tr>
          {%- endfor -%}
          {%- for line in order.shipping_methods -%}
            <tr><td colspan="3">{{ 'account.shipping' | t }} ({{ line.title }})</td><td>{{ line.price | money }}</td></tr>
          {%- endfor -%}
          {%- for line in order.tax_lines -%}
            <tr><td colspan="3">{{ 'account.tax' | t }} ({{ line.rate_percentage }}%)</td><td>{{ line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><th colspan="3">{{ 'account.total' | t }}</th><th>{{ order.total_price | money_with_currency }}</th></tr>
        </tfoot>
      </table>
    </div>
    <div class="cols" style="--n:2">
      <div class="col"><span class="col__k">{{ 'account.billing' | t }}</span><p>{{ order.billing_address | format_address }}</p></div>
      <div class="col"><span class="col__k">{{ 'account.shipping_address' | t }}</span><p>{{ order.shipping_address | format_address }}</p></div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Order", "class": "section-order", "settings": [] }
{% endschema %}
