{%- liquid
  assign keys = 'veil,mirage,ember,halo' | split: ','
  assign pairs = 'veil_mirage,veil_ember,veil_halo,mirage_ember,mirage_halo,ember_halo' | split: ','
  assign charm_id = 0
  if settings.charm != blank and settings.charm.available
    assign charm_in = false
    for item in cart.items
      if item.product_id == settings.charm.id
        assign charm_in = true
      endif
    endfor
    unless charm_in
      assign charm_id = settings.charm.selected_or_first_available_variant.id
    endunless
  endif
-%}
<section class="pairs on-dark sec" id="pairs" data-pairs data-charm="{{ charm_id }}" data-start="{{ section.settings.start }}" data-first="{{ 'pair.first' | t | escape }}" data-over="{{ 'pair.over' | t | escape }}">
  <span class="pairs__bg" aria-hidden="true"></span>
  <div class="wrap pairs__in">
    <div style="display:grid;gap:20px" data-reveal>
      <p class="lab">{% if section.settings.label != blank %}{{ section.settings.label }}{% else %}{{ 'pair.lab' | t }}{% endif %}</p>
      <h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'pair.h' | t }}{% endif %}</h2>
      <div class="pairs__lines">
        <span>{{ 'pair.line1' | t }}</span>
        <span>{{ 'pair.line2' | t }}</span>
      </div>
      <p class="body">{{ 'pair.p' | t }}</p>

      <div>
        <p class="lab lab--plain" data-pair-count data-tpl="{{ 'pair.count' | t: n: '__N__' | escape }}">{{ 'pair.count' | t: n: 0 }}</p>
        <div class="pairs__pick" role="group" aria-label="{{ 'pair.pick' | t }}">
          {%- for key in keys -%}
            {%- assign sid = 'musk_' | append: key -%}
            {%- assign p = settings[sid] -%}
            {%- assign nk = 'musks.' | append: key | append: '.name' -%}
            <button class="m-{{ key }}" type="button" aria-pressed="false"
              data-pair-key="{{ key }}"
              data-variant="{{ p.selected_or_first_available_variant.id | default: 0 }}"
              data-price="{{ p.price | default: 0 }}"
              data-available="{% if p != blank and p.available %}true{% else %}false{% endif %}">
              <i aria-hidden="true"></i><b>{{ nk | t }}</b><small></small>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <p class="fine" data-pair-hint>{{ 'pair.hint' | t }}</p>

      <div class="pairs__res" data-pair-res hidden aria-live="polite">
        {%- for pk in pairs -%}
          {%- assign tk = 'pair.' | append: pk -%}
          <p data-pair-text="{{ pk }}" hidden>{{ tk | t }}</p>
        {%- endfor -%}
        <form class="pairs__buy" action="{{ routes.cart_add_url }}" method="post" data-add data-items="[]">
          <span class="pairs__price" data-pair-price></span>
          <button class="btn btn--light" type="submit"><span>{{ 'pair.add' | t }}</span></button>
          <span class="pairs__incl">{{ 'pair.incl' | t }}</span>
          {%- if settings.charm != blank -%}
            {%- assign charm_worth = settings.charm.price | money -%}
            <span class="pairs__worth">{{ 'pair.worth' | t: n: charm_worth }}</span>
          {%- endif -%}
          <p class="msg msg--err" data-form-error hidden></p>
        </form>
        <p class="fine">{{ 'pair.charm' | t }}</p>
      </div>
    </div>

    <div class="pairs__stage" aria-hidden="true">
      <div class="pairs__tubes">
        {%- for key in keys -%}
          <span data-pair-tube="{{ key }}" hidden>{% render 'tube', key: key %}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pair builder",
  "class": "section-pairs",
  "settings": [
    { "type": "paragraph", "content": "Pick two musks, read how they wear together, add both with the bag charm. The charm product is set in Theme settings > The four musks." },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "start",
      "label": "Pair shown first",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "veil,ember", "label": "VEIL and EMBER" },
        { "value": "veil,mirage", "label": "VEIL and MIRAGE" },
        { "value": "veil,halo", "label": "VEIL and HALO" },
        { "value": "mirage,halo", "label": "MIRAGE and HALO" }
      ],
      "default": "veil,ember"
    }
  ],
  "presets": [{ "name": "Pair builder" }]
}
{% endschema %}
