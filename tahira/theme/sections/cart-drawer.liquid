<div id="CartDrawer" class="drawer drawer--end" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
  <div data-drawer-inner style="display:contents">
    <span hidden data-cart-count-src="{{ cart.item_count }}"></span>
    <div class="drawer__top">
      <h2>{{ 'cart.title' | t }}{% if cart.item_count > 0 %} <span class="fine">({{ cart.item_count }})</span>{% endif %}</h2>
      <button class="icon-btn" type="button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="drawer__body">
        <div class="bag__empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a class="btn" href="{{ settings.musks_collection.url | default: routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    {%- else -%}
      <div class="drawer__body bag__body">
        {% render 'bag-extras', position: 'top' %}
        {% render 'bag-lines', interactive: true %}
        {% render 'bag-extras', position: 'upsell' %}
        <p class="msg msg--err bag__err" data-bag-error hidden></p>
      </div>
      <div class="bag__foot">
        {%- for d in cart.cart_level_discount_applications -%}
          <div class="bag__row fine"><span>{{ d.title }}</span><span>-{{ d.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="bag__row"><span>{{ 'cart.sub' | t }}</span><b>{{ cart.total_price | money }}</b></div>
        {% render 'split-pay', price: cart.total_price %}
        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </form>
        <div class="bag__pay">
          <span>{{ 'product.cod' | t }}</span><span>Tabby</span><span>Tamara</span><span>Apple Pay</span>
        </div>
        <p class="fine" style="text-align:center">{{ 'cart.taxes' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Bag drawer",
  "settings": []
}
{% endschema %}
