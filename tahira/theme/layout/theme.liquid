<!doctype html>
{%- liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{% if is_ar %}rtl{% else %}ltr{% endif %}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- endif -%}

  {%- capture page_title -%}
    {%- if template.name == 'index' -%}
      {{ shop.name }}
    {%- else -%}
      {{ page_title }}{% if current_tags %} {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} {{ 'general.page' | t: n: current_page }}{% endif %} | {{ shop.name }}
    {%- endif -%}
  {%- endcapture -%}
  <title>{{ page_title | strip }}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@200;300;400;500&display=swap">
  {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
  {% render 'css-variables' %}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.TAHIRA = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }}
      },
      moneyFormat: {{ shop.money_format | json }},
      locale: {{ request.locale.iso_code | json }},
      cartDrawer: {{ settings.cart_drawer | json }},
      freeShipping: {{ settings.free_shipping | default: 0 | times: 100 | json }},
      cutoff: {{ settings.cutoff_hour | json }},
      weekend: {{ settings.weekend | json }},
      splitCount: {{ settings.split_count | json }},
      reveal: {{ settings.reveal | json }},
      strings: {
        add: {{ 'product.add' | t | json }},
        added: {{ 'product.added' | t | json }},
        adding: {{ 'product.adding' | t | json }},
        soldOut: {{ 'product.sold_out' | t | json }},
        error: {{ 'cart.error' | t | json }},
        shipToday: {{ 'product.ship_today' | t: t: '__T__' | json }},
        shipNext: {{ 'product.ship_next' | t: d: '__D__' | json }},
        eta: {{ 'product.eta' | t: a: '__A__', b: '__B__' | json }},
        h: {{ 'product.h' | t | json }},
        m: {{ 'product.m' | t | json }},
        split: {{ 'product.split' | t: n: '__N__', c: '__C__' | json }},
        days: [
          {{ 'product.day0' | t | json }}, {{ 'product.day1' | t | json }}, {{ 'product.day2' | t | json }},
          {{ 'product.day3' | t | json }}, {{ 'product.day4' | t | json }}, {{ 'product.day5' | t | json }},
          {{ 'product.day6' | t | json }}
        ]
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>

<body class="tpl-{{ template.name }}{% if template.suffix %} tpl-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip" href="#main">{{ 'general.skip' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.cart_drawer and template.name != 'cart' -%}
    {% section 'cart-drawer' %}
  {%- endif -%}

  {%- if settings.whatsapp != blank -%}
    {%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
    <a class="wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="{{ 'general.whatsapp' | t }}">
      {% render 'icon', name: 'whatsapp' %}
    </a>
  {%- endif -%}
</body>
</html>
