<!doctype html>
{%- liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{% if is_ar %}rtl{% else %}ltr{% endif %}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- endif -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}
  {{ content_for_header }}
</head>
<body class="tpl-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
